+
+        sage: print(es(s, 3))
+        def test1(a, b=2):                         # 3
+            if a:                                  # 4
+                return 1                           # 5
+            return b                               # 6
+
+        sage: print(es(s, 8))
+        class test2():                             # 8
+            pass                                   # 9
+
+        sage: print(es(s, 12))
+        def test3(b,                               # 12
+                  a=2):                            # 13
+            pass # EOF                             # 14
+
+    Test _sage_getargspec_cython with multiple default arguments and a type::
+
